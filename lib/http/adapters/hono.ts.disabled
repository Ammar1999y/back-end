/**
 * Hono adapter — DISABLED.
 *
 * Rename to `hono.ts` when migrating to Hono. This file is `.disabled` so the
 * TypeScript compiler ignores it while Elysia is the active framework.
 *
 * Read `docs/framework-migration.md` first: the Next -> Elysia migration moved
 * everything framework-independent out of the adapters, and the migration-review
 * pass moved more, so this one is now almost empty. Body parsing, IP extraction,
 * the pre-auth limiter, cookie serialisation, response building, the response
 * policy, the 404-vs-405 boundary and the post-response seam are all shared:
 *
 *   routes.ts                     the route table AS DATA — reuse it verbatim
 *   lib/http/contract.ts          Handler / HandlerInput / HandlerOutput
 *   lib/http/route-manifest.ts    the manifest, the method lookup, `allowHeader`
 *   lib/http/request.ts           buildRequestMeta(request, params) + withBodyPolicy(meta, policy)
 *   lib/http/response.ts          toWebResponse(output)
 *   lib/http/response-policy.ts   applyResponsePolicy(response, opts)
 *   lib/http/pre-auth.ts          enforcePreAuthIpLimit(meta)
 *   lib/http/after-response.ts    runAfterResponse(request, summary)
 *   lib/http/openapi.ts           openApiDocument(manifest)
 *
 * Required packages when activating:
 *   bun add hono
 *
 * Three things a Hono migration must NOT skip, because they do not live here:
 *
 *   1. `app.ts` — the route registration loop, CORS, the response policy, the
 *      405 boundary, the trailing-slash redirect and the post-response wiring.
 *      Import `CORS_POLICY` from it rather than retyping the values: the
 *      previous version of this file hardcoded them and immediately drifted —
 *      it was missing `X-Captcha-Response`, which blocked every browser sign-in.
 *   2. `server.ts` — the runtime assertions (`NODE_ENV`, `PORT`, `Bun.version`,
 *      `sqlite_version()`), the explicit `idleTimeout`, `reusePort: false`,
 *      `maxRequestBodySize`, and the SIGTERM drain. None of it is Elysia-specific
 *      and all of it is load-bearing.
 *   3. `lib/sqlite/driver.ts` — only if the runtime stops being Bun. Hono runs
 *      on Bun, so `bun:sqlite` stays correct and nothing changes.
 *
 * Better Auth ships no first-class Hono integration; serve it from the prefix in
 * `ROUTE_PREFIXES`, restricted to GET and POST as `app.ts` already does.
 */

/*

import type { Context } from 'hono';

import { handleApiError } from '@/utils/api-response';

import type { RouteDefinition } from '../route-manifest';
import { enforcePreAuthIpLimit } from '../pre-auth';
import { buildRequestMeta, withBodyPolicy } from '../request';
import { toWebResponse } from '../response';

// -------------------------------------------------------------------------
// 1. Route adapter
//
// The ORDER is the security-relevant part and must not be rearranged: read the
// head, run admission checks against it, and only then hand the handler LAZY
// readers in the shape the route declared. The inverse order buffers an
// attacker-supplied body before anything decides whether the request is allowed.
//
// `withBodyPolicy` is SYNCHRONOUS and parses nothing — do not `await` it and do
// not reintroduce an eager parse here. That is what extends "check, then read" to
// routes whose only admission check lives inside their own handler (the OTP
// endpoints, which carry per-identifier budgets instead of the coarse per-IP
// one). Hono must also be told not to pre-parse: read the body only through
// `ctx.readJson()` / `ctx.readFormData()`, never `c.req.json()`, or the stream is
// drained before the handler decides.
// -------------------------------------------------------------------------

export function toHonoHandler(route: RouteDefinition) {
  return async (c: Context): Promise<Response> => {
    try {
      const meta = buildRequestMeta(c.req.raw, c.req.param());
      if (route.preAuth === 'ip-limit') await enforcePreAuthIpLimit(meta);
      return toWebResponse(
        await route.handler(withBodyPolicy(meta, route.body))
      );
    } catch (error) {
      return toWebResponse(handleApiError(error));
    }
  };
}

