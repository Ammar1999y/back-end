/*

import type { Context } from 'hono';
import { setCookie } from 'hono/cookie';

import { auth } from '@/lib/auth';
import { getClientIp } from '@/lib/audit';
import { handleApiError } from '@/utils/api-response';

import type { Handler, HandlerInput, HandlerOutput } from '../contract';

// -------------------------------------------------------------------------
// 1. Route adapter
// -------------------------------------------------------------------------

export function toHonoRoute(handler: Handler) {
  return async (c: Context) => {
    try {
      const input = await buildContext(c);
      const output = await handler(input);
      return writeResponse(output, c);
    } catch (error) {
      return writeResponse(handleApiError(error), c);
    }
  };
}

async function buildContext(c: Context): Promise<HandlerInput> {
  const request = c.req.raw;
  const url = new URL(request.url);
  const body = await safeReadJson(request);

  return {
    body,
    query: url.searchParams,
    params: c.req.param() as Record<string, string>,
    headers: request.headers,
    url: request.url,
    method: request.method,
    ip: getClientIp(request.headers) ?? '',
    userAgent: request.headers.get('user-agent'),
    apiPath: url.pathname,
    rawRequest: request,
  };
}

async function safeReadJson(request: Request): Promise<unknown> {
  const method = request.method.toUpperCase();
  if (method === 'GET' || method === 'HEAD') return null;
  const contentType = request.headers.get('content-type') ?? '';
  if (!contentType.includes('application/json')) return null;
  try {
    const text = await request.text();
    return text ? JSON.parse(text) : null;
  } catch {
    return null;
  }
}

function writeResponse(output: HandlerOutput, c: Context) {
  if (output.headers) {
    for (const [key, value] of Object.entries(output.headers)) {
      c.header(key, value);
    }
  }
  if (output.cookies) {
    for (const cookie of output.cookies) {
      setCookie(c, cookie.name, cookie.value, cookie.options);
    }
  }
  return c.json(output.body, output.status as 200);
}

