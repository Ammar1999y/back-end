{
  "name": "app",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "probe:local": "bun scripts/probe/local/time-dst.ts && bun scripts/probe/local/log-serializer.ts && bun scripts/probe/local/permission-schema.ts && bun test scripts/probe/local",
    "probe:db": "bun test ./scripts/probe/dev-live/database/otp-verify-budget.dev-probe.ts",
    "probe:redis": "bun test ./scripts/probe/dev-live/redis/otp-global-breaker.dev-probe.ts",
    "find:unused-files": "bun scripts/find-unused-files.ts && bun add -D knip && bunx knip",
    "find:non-null": "bun scripts/find-non-null-assertions.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:sql": "bun scripts/apply-sql-migrations.ts"
  },
  "packageManager": "bun@1.3.14",
  "browserslist": [
    "Chrome >= 80",
    "Firefox >= 74",
    "Safari >= 15",
    "defaults and fully supports es6-module and not dead"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@better-auth/core": "^1.6",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "^1.3",
    "@neondatabase/serverless": "^1",
    "@tanstack/react-table": "^9",
    "@upstash/ratelimit": "^2",
    "@upstash/redis": "^1",
    "argon2": "^0.45",
    "better-auth": "^1.6",
    "blurhash": "^2",
    "drizzle-orm": "^0.45",
    "isomorphic-dompurify": "^3",
    "jsdom": "^30",
    "next": "16.3.1",
    "nodemailer": "^9",
    "sharp": "^0.35",
    "svgo": "^4",
    "uuid": "^14",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28",
    "@types/node": "24",
    "@types/nodemailer": "^8",
    "@types/react": "^19",
    "drizzle-kit": "^0.31",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-drizzle": "^0.2",
    "eslint-plugin-import": "^2",
    "eslint-plugin-no-unsanitized": "^4",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-security": "^4",
    "eslint-plugin-unicorn": "^73",
    "knip": "^6.32.2",
    "prettier": "^3.6",
    "typescript": "^6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "argon2",
    "sharp",
    "unrs-resolver"
  ]
}
