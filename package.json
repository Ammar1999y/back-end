{
  "name": "app",
  "version": "0.1.0",
  "scripts": {
    "preinstall": "bun scripts/require-bun.mjs",
    "dev": "NODE_ENV=development bun --watch --bun server.ts",
    "start": "NODE_ENV=production bun --bun server.ts",
    "build": "bun scripts/build-openapi.ts && tsc --noEmit",
    "lint": "tsc --noEmit && eslint . --max-warnings 0",
    "test": "bun tests/helpers/run.ts unit",
    "test:integration": "bun tests/helpers/run.ts integration",
    "test:process": "bun tests/helpers/run.ts process",
    "test:all": "bun tests/helpers/run.ts unit && bun tests/helpers/run.ts integration && bun tests/helpers/run.ts process && bun tests/helpers/run.ts matrix",
    "test:db:reset": "bun tests/helpers/reset.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit",
    "find:unused-files": "bun scripts/find-unused-files.ts && bunx knip",
    "find:non-null": "bun scripts/find-non-null-assertions.ts",
    "check:coverage": "bun scripts/check-coverage.ts",
    "precommit": "lefthook run fix && lefthook run verify",
    "verify": "lefthook run verify",
    "fix": "lefthook run fix",
    "scan:secrets": "mise exec -- gitleaks git . --redact --verbose --no-banner",
    "scan:sast": "mise exec -- semgrep scan --config=p/typescript --config=p/secrets --error --metrics=off",
    "prepare": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "smoke": "bun scripts/smoke.ts",
    "check:runtime": "bun scripts/require-bun.mjs",
    "preflight:credentials": "bun scripts/check-password-peppers.ts",
    "preflight:two-factor": "bun scripts/check-two-factor-rollout.ts",
    "test:matrix": "bun tests/helpers/run.ts matrix"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "npm": "use bun (run: node scripts/require-bun.mjs)",
    "yarn": "use bun (run: node scripts/require-bun.mjs)",
    "pnpm": "use bun (run: node scripts/require-bun.mjs)"
  },
  "overrides": {
    "esbuild": "^0.28"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@better-auth/passkey": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "^1.3",
    "@elysia/cors": "^1.4",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.45",
    "better-auth": "^1.7.2",
    "blurhash": "^2",
    "drizzle-orm": "^0.45",
    "elysia": "^1.4",
    "isomorphic-dompurify": "^3",
    "jsdom": "^30",
    "nodemailer": "^9",
    "svgo": "^4",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.2",
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7",
    "@types/bun": "^1.4.0",
    "@types/jsdom": "^30",
    "@types/node": "^24",
    "@types/nodemailer": "^8",
    "drizzle-kit": "^0.31",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-drizzle": "^0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-unsanitized": "^4",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-security": "^4",
    "eslint-plugin-unicorn": "^73",
    "globals": "^17",
    "knip": "^6",
    "lefthook": "^2",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8"
  },
  "trustedDependencies": [
    "argon2"
  ]
}
