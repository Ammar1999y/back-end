{
  "name": "app",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "bun --bun run next build",
    "start": "bun --bun run next start",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "packageManager": "bun@1.3.14",
  "browserslist": [
    "Chrome >= 80",
    "Firefox >= 74",
    "Safari >= 15",
    "defaults and fully supports es6-module and not dead"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-table": "^9.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "argon2": "^0.45.1",
    "better-auth": "1.6.26",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.21.0",
    "jsdom": "^30",
    "next": "16.3.0",
    "nodemailer": "^9.0.4",
    "svgo": "^4",
    "uuid": "^14",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "24",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import": "^2",
    "eslint-plugin-no-unsanitized": "^4",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-security": "^3",
    "eslint-plugin-unicorn": "^64",
    "prettier": "^3.6",
    "typescript": "^6"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "argon2",
    "sharp",
    "unrs-resolver"
  ]
}
