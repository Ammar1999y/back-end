8`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`This replaces the deprecated `,_jsx(_components.code,{children:`ignorePatterns`}),` configuration. Claude Code excludes files matching these patterns from file discovery and search results, denies read operations on them, and blocks the `,_jsx(_components.a,{href:`/en/permissions#read-and-edit`,children:`Edit and Write tools`}),` on the matching paths.`]}),`\n`,_jsx(Heading,{level:`2`,id:`subagent-configuration`,children:`Subagent configuration`}),`\n`,_jsx(_components.p,{children:`Claude Code supports custom AI subagents that can be configured at both user and project levels. You define each subagent as a Markdown file with YAML frontmatter, saved in one of these locations:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`User subagents`}),`: `,_jsx(_components.code,{children:`~/.claude/agents/`}),`, available across all your projects`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Project subagents`}),`: `,_jsx(_components.code,{children:`.claude/agents/`}),`, specific to your project and shareable with your team`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Subagent files define specialized AI assistants with custom prompts and tool permissions. Learn more about creating and using subagents in the `,_jsx(_components.a,{href:`/en/sub-agents`,children:`subagents documentation`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`plugin-configuration`,children:`Plugin configuration`}),`\n`,_jsx(_components.p,{children:`Claude Code supports a plugin system that lets you extend functionality with skills, agents, hooks, and MCP servers. Plugins are distributed through marketplaces and can be configured at both user and repository levels.`}),`\n`,_jsx(Heading,{level:`3`,id:`plugin-settings`,children:`Plugin settings`}),`\n`,_jsxs(_components.p,{children:[`Plugin-related settings in `,_jsx(_components.code,{children:`settings.json`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`15`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`15`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"enabledPlugins\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"formatter@acme-tools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"deployer@acme-tools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"analyzer