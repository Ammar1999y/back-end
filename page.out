nts.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"label\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"{key}\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  ]`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`With this configured, when `,_jsx(_components.code,{children:`PROJ-1234`}),` appears in a tool result or in Claude’s reply, a `,_jsx(_components.code,{children:`PROJ-1234`}),` badge appears in the footer linking to `,_jsx(_components.code,{children:`https://issues.example.com/browse/PROJ-1234`}),`.`]}),`\n`,_jsx(_components.p,{children:`The following constraints apply to each entry:`}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{style:{textAlign:`left`},children:`Constraint`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Behavior`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`URL origin`}),_jsx(_components.td,{style:{textAlign:`left`},children:`Captured values are URL-encoded and the constructed URL must share the template’s literal origin. A capture can fill a path segment or query value but cannot change where the link points`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`URL length`}),_jsx(_components.td,{style:{textAlign:`left`},children:`Constructed URLs longer than 2048 characters are dropped`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`URL scheme`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Must be `,_jsx(_components.code,{children:`https`}),`, `,_jsx(_components.code,{children:`http`}),`, or a recognized editor or workspace deep-link scheme: `,_jsx(_components.code,{children:`vscode`}),`, `,_jsx(_components.code,{children:`vscode-insiders`}),`, `,_jsx(_components.code,{children:`cursor`}),`, `,_jsx(_components.code,{children:`windsurf`}),`, `,_jsx(_components.code,{children:`zed`}),`, `,_jsx(_components.code,{children:`jetbrains`}),`, `,_jsx(_components.code,{children:`idea`}),`, `,_jsx(_components.code,{children:`slack`}),`, `,_jsx(_components.code,{children:`linear`}),`, `,_jsx(_components.code,{children:`notion`}),`, `,_jsx(_components.code,{children:`figma`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`Label`}),_jsx(_components.td,{style:{textAlign:`left`},children:`Defaults to the matched text and is truncated to 28 display columns`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`Badge count`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`At most 5 badges render. The oldest is displaced by newer matches and `,_jsx(_components.code,{children:`/clear`}),` removes them`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`Settings scope`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Read from user settings, the `,_jsx(_components.code,{children:`--settings`}),` flag, and managed settings only. Ignored in project `,_jsx(_components.code,{children:`.claude/settings.json`}),` and local `,_jsx(_components.code,{children:`.claude/settings.local.json`})]})]})]})]}),`\n`,_jsxs(_components.p,{children:[`When a turn completes, Claude Code matches each entry’s `,_jsx(_components.code,{children:`pattern`}),` regex against the turn output on the main thread, so a slow regex blocks the UI until it finishes. Nested quantifiers such as `,_jsx(_components.code,{children:`(a+)+$`}),` can take exponentially long against certain inputs and freeze the session, so keep each `,_jsx(_components.code,{children:`pattern`}),` linear and avoid nesting `,_jsx(_components.code,{children:`+`}),` or `,_jsx(_components.code,{children:`*`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Footer badges render alongside a `,_jsx(_components.a,{href:`/en/statusline`,children:`custom status line`}),` when one is configured; neither replaces the other. Use a status line for a script-driven row that computes its own content from session data, and footer badges to turn IDs from the conversation into links without a script.`]}),`\n`,_jsx(Heading,{level:`3`,id:`hook-configuration`,children:`Hook configuration`}),`\n`,_jsxs(_components.p,{children:[`These settings control which hooks are allowed to run and what HTTP hooks can access. The `,_jsx(_components.code,{children:`allowManagedHooksOnly`}),` setting can only be configured in `,_jsx(_components.a,{href:`#settings-files`,children:`managed settings`}),`. The URL and env var allowlists can be set at any settings level and merge across sources.`]}),`\n`,_jsx(_components.p,{children:_jsxs(_components.strong,{children:[`Behavior when `,_jsx(_components.code,{children:`allowManagedHooksOnly`}),` is `,_jsx(_components.code,{children:`true`}),`:`]})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Managed hooks and SDK hooks are loaded`}),`\n`,_jsxs(_components.li,{children:[`Hooks from plugins force-enabled in managed settings `,_jsx(_components.code,{children:`enabledPlugins`}),` are loaded. This lets administrators distribute vetted hooks through an organization marketplace while blocking everything else. Trust is granted by full `,_jsx(_components.code,{children:`plugin@marketplace`}),` ID, so a plugin with the same name from a different marketplace stays blocked`]}),`\n`,_jsx(_components.li,{children:`User hooks, project hooks, local hooks, and all other plugin hooks are blocked`}),`\n`,_jsxs(_components.li,{children:[`Claude Code also disables plugins with a `,_jsxs(_components.a,{href:`/en/plugin-marketplaces#command-sources`,children:[_jsx(_components.code,{children:`command`}),` source`]}),`, including plugins force-enabled in managed settings `,_jsx(_components.code,{children:`enabledPlugins`}),`, unless `,_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`disableCommandPluginSources`})}),` is explicitly set to `,_jsx(_components.code,{children:`false`})]}),`\n`,_jsxs(_components.li,{children:[`Claude Code also narrows `,_jsx(_components.a,{href:`/en/statusline`,children:_jsx(_components.code,{children:`statusLine`})}),`, `,_jsx(_components.a,{href:`#file-suggestion-settings`,children:_jsx(_components.code,{children:`fileSuggestion`})}),`, and `,_jsx(_components.a,{href:`/en/statusline#subagent-status-lines`,children:_jsx(_components.code,{children:`subagentStatusLine`})}),` to managed settings, following the two decisions below`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Status line and file suggestion gates:`}),` Claude Code makes two decisions for `,_jsx(_components.code,{children:`statusLine`}),`, `,_jsx(_components.code,{children:`fileSuggestion`}),`, and `,_jsx(_components.code,{children:`subagentStatusLine`}),`. It turns the feature off entirely when managed settings set `,_jsx(_components.code,{children:`disableAllHooks`}),`, or when the folder isn’t trusted under the same `,_jsx(_components.a,{href:`/en/permissions#what-runs-before-you-trust-a-folder`,children:`workspace trust rule as hooks in settings files`}),`. It narrows the source to managed settings when `,_jsx(_components.code,{children:`allowManagedHooksOnly`}),` is set or when `,_jsx(_components.code,{children:`disableAllHooks`}),` is `,_jsx(_components.code,{children:`true`}),` outside managed settings after `,_jsx(_components.a,{href:`/en/hooks#disable-or-remove-hooks`,children:`settings precedence`}),` applies. Under narrowing, Claude Code runs a managed value if one is deployed; otherwise it skips your value without warning, the status line is disabled, and `,_jsx(_components.code,{children:`@`}),` autocomplete falls back to the built-in file suggestion.`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Restrict HTTP hook URLs:`})}),`\n`,_jsxs(_components.p,{children:[`Limit which URLs HTTP hooks can target. Supports `,_jsx(_components.code,{children:`*`}),` as a wildcard for matching. When the array is defined, HTTP hooks targeting non-matching URLs are silently blocked. Hostname matching is case-insensitive and ignores a trailing FQDN dot, matching DNS semantics.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"allowedHttpHookUrls\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"https://hooks.example.com/*\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"http://localhost:*\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Restrict HTTP hook environment variables:`})}),`\n`,_jsxs(_components.p,{children:[`Limit which environment variable names HTTP hooks can interpolate into header values. Each hook’s effective `,_jsx(_components.code,{children:`allowedEnvVars`}),` is the intersection of its own list and this setting.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"httpHookAllowedEnvVars\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"MY_TOKEN\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"HOOK_SECRET\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`compute-managed-settings-with-a-policy-helper`,children:`Compute managed settings with a policy helper`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`policyHelper`}),` setting points at an executable that computes managed settings at startup, so admins can derive policy from device posture, identity, or a remote service instead of a static file. Configure it from MDM or a system `,_jsx(_components.code,{children:`managed-settings.json`}),` file. Claude Code ignores `,_jsx(_components.code,{children:`policyHelper`}),` when it appears in any other scope, including user settings, project settings, the HKCU registry hive, and `,_jsx(_components.a,{href:`/en/server-managed-settings`,children:`server-managed settings`}),`.`]}),`\n`,_jsx(_components.p,{children:`The setting accepts these keys:`}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Key`}),_jsx(_components.th,{children:`Type`}),_jsx(_components.th,{children:`Description`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`path`})}),_jsx(_components.td,{children:`string`}),_jsx(_components.td,{children:`Absolute path to the helper executable`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`timeoutMs`})}),_jsx(_components.td,{children:`number`}),_jsx(_components.td,{children:`How long to wait for the helper before treating the run as failed`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.code,{children:`refreshIntervalMs`})}),_jsx(_components.td,{children:`number`}),_jsxs(_components.td,{children:[`How often to re-run the helper in the background. Set to `,_jsx(_components.code,{children:`0`}),` to disable refresh, or to at least `,_jsx(_components.code,{children:`60000`})]})]})]})]}),`\n`,_jsxs(_components.p,{children:[`The helper writes a JSON envelope to stdout. Put the settings under a `,_jsx(_components.code,{children:`managedSettings`}),` key rather than at the top level, since a bare settings object parses with `,_jsx(_components.code,{children:`managedSettings`}),` undefined and applies nothing:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`7`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`7`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"managedSettings\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"permissions\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: { `}),_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`\"deny\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"Read(//etc/secrets/**)\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`] }`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  },`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"claudeMd\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"# Organization context`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:`\\\\n`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`...\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"appendSystemPrompt\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"Always cite the internal style guide.\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Claude Code reads `,_jsx(_components.code,{children:`policyHelper`}),` only from the source that wins `,_jsx(_components.a,{href:`#precedence-within-the-managed-tier`,children:`precedence within the managed tier`}),`, so a helper configured in MDM or a managed settings file does not run while server-managed settings deliver a non-empty configuration. When the helper runs and emits `,_jsx(_components.code,{children:`managedSettings`}),`, that object becomes the only managed settings source for the run: Claude Code ignores the MDM and file-based sources, reads the `,_jsx(_components.a,{href:`#precedence-within-the-managed-tier`,children:`cross-source keys`}),` from the helper’s output alone, and never merges `,_jsx(_components.a,{href:`#parent-settings-from-embedding-hosts`,children:`parent settings`}),`. A helper that exits 0 without emitting `,_jsx(_components.code,{children:`managedSettings`}),` contributes no managed settings, and the other sources apply as usual. When the helper exits non-zero at startup, Claude Code prints the error and refuses to start, so a helper that needs outage resilience should serve from its own cache and exit `,_jsx(_components.code,{children:`0`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`settings-precedence`,children:`Settings precedence`}),`\n`,_jsxs(_components.p,{children:[`Claude Code reads settings from these levels, highest precedence first. A few security-sensitive keys and one host-integration case don’t follow this order, in either direction; `,_jsx(_components.a,{href:`#exceptions-to-managed-settings-precedence`,children:`Exceptions to managed settings precedence`}),` lists them.`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Managed settings`}),` (`,_jsx(_components.a,{href:`/en/server-managed-settings`,children:`server-managed`}),`, `,_jsx(_components.a,{href:`#configuration-scopes`,children:`MDM/OS-level policies`}),`, or `,_jsx(_components.a,{href:`/en/settings#settings-files`,children:`managed settings files`}),`)`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Your organization deploys these through server delivery, MDM configuration profiles, registry policies, or managed settings files`}),`\n`,_jsxs(_components.li,{children:[`No other level overrides them, including command line arguments, apart from the `,_jsx(_components.a,{href:`#exceptions-to-managed-settings-precedence`,children:`exceptions to managed settings precedence`})]}),`\n`,_jsxs(_components.li,{children:[`When your organization delivers more than one managed source, `,_jsx(_components.a,{href:`#precedence-within-the-managed-tier`,children:`precedence within the managed tier`}),` determines what Claude Code reads from each`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Command line arguments`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Values you pass for one session. JSON you pass with `,_jsx(_components.code,{children:`--settings \u003cfile-or-json\u003e`}),` merges with your settings files by the same rules as the other levels: a key you set here overrides the same key in local, project, or user settings, and a key you omit keeps its lower-level value`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Local project settings`}),` (`,_jsx(_components.code,{children:`.claude/settings.local.json`}),`)`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Your personal settings for this project`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Shared project settings`}),` (`,_jsx(_components.code,{children:`.claude/settings.json`}),`)`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Settings your team checks into source control`}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`User settings`}),` (`,_jsx(_components.code,{children:`~/.claude/settings.json`}),`)`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Your personal settings for every project`}),`\n`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`The same order applies whether you run Claude Code from the CLI, the `,_jsx(_components.a,{href:`/en/vs-code`,children:`VS Code extension`}),`, or a `,_jsx(_components.a,{href:`/en/jetbrains`,children:`JetBrains IDE`}),`. For example, if you set `,_jsx(_components.code,{children:`spinnerTipsEnabled`}),` to `,_jsx(_components.code,{children:`true`}),` in your user settings and your team sets it to `,_jsx(_components.code,{children:`false`}),` in the project’s shared settings, the project value applies.`]}),`\n`,_jsxs(Note,{children:[_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Array settings merge across scopes.`}),` When you set the same array-valued key, such as `,_jsx(_components.code,{children:`sandbox.filesystem.allowWrite`}),` or `,_jsx(_components.code,{children:`permissions.allow`}),`, in more than one scope, Claude Code concatenates and deduplicates the arrays instead of replacing one with another, so each scope can add entries without removing another scope’s. For example, if managed settings set `,_jsx(_components.code,{children:`allowWrite`}),` to `,_jsx(_components.code,{children:`[\"/opt/company-tools\"]`}),` and you add `,_jsx(_components.code,{children:`[\"~/.kube\"]`}),` in your user settings, Claude Code allows writes to both paths.`]}),_jsx(_components.p,{children:`Two array keys don’t merge this way:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`fallbackModel`})}),` is an ordered chain where position carries meaning, so Claude Code takes the whole value from the highest-precedence file that defines it.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`availableModels`})}),`: when the `,_jsx(_components.a,{href:`#precedence-within-the-managed-tier`,children:`highest-precedence managed source`}),` defines it, Claude Code applies that list as-is, apart from a `,_jsx(_components.a,{href:`#exceptions-to-managed-settings-precedence`,children:`host platform that supplies its own`}),`, and ignores entries you add in user, project, or local settings. Across non-managed scopes the arrays merge as usual. See `,_jsx(_components.a,{href:`/en/model-config#merge-behavior`,children:`Merge behavior`}),`.`]}),`\n`]})]}),`\n`,_jsx(Heading,{level:`4`,id:`exceptions-to-managed-settings-precedence`,children:`Exceptions to managed settings precedence`}),`\n`,_jsx(_components.p,{children:`For a few security-sensitive keys, Claude Code honors a restrictive value from a scope that otherwise couldn’t override managed settings. Find the key in this table to see which value it honors and from where.`}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{style:{textAlign:`left`},children:`Key`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Value Claude Code honors`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Notes`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`disableClaudeAiConnectors`})})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`true`}),` from any scope`]}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Honored even when a managed source sets `,_jsx(_components.code,{children:`false`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`isolatePeerMachines`})})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`true`}),` from any scope`]}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Honored even when a managed source sets `,_jsx(_components.code,{children:`false`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`remoteControlAtStartup`})})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`false`}),` from `,_jsx(_components.code,{children:`.claude/settings.json`}),` or `,_jsx(_components.code,{children:`.claude/settings.local.json`})]}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Honored even when a managed source sets `,_jsx(_components.code,{children:`true`}),`. Claude Code ignores a `,_jsx(_components.code,{children:`true`}),` in those two files: you can turn auto-connect on only from user settings, the `,_jsx(_components.code,{children:`--settings`}),` flag, or managed settings, and a `,_jsx(_components.code,{children:`false`}),` in your user settings doesn’t override a managed `,_jsx(_components.code,{children:`true`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`crossSessionInbound`})})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`A stricter value from `,_jsx(_components.code,{children:`.claude/settings.json`}),` or `,_jsx(_components.code,{children:`.claude/settings.local.json`}),`, on the `,_jsx(_components.code,{children:`accept`}),` \u003c `,_jsx(_components.code,{children:`hold`}),` \u003c `,_jsx(_components.code,{children:`refuse`}),` ladder`]}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Honored over the value from managed settings, the `,_jsx(_components.code,{children:`--settings`}),` flag, or user settings. Claude Code ignores a project or local value that isn’t stricter, so a checked-in `,_jsx(_components.code,{children:`accept`}),` never overrides the `,_jsx(_components.code,{children:`hold`}),` or `,_jsx(_components.code,{children:`refuse`}),` in your user settings`]})]})]})]}),`\n`,_jsxs(_components.p,{children:[`A host platform that embeds Claude Code and sets `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST`})}),` is also an exception. Claude Code takes the host’s model configuration over the `,_jsx(_components.code,{children:`model`}),`, `,_jsx(_components.code,{children:`fallbackModel`}),`, and `,_jsx(_components.code,{children:`modelOverrides`}),` keys from every managed source, and over the model-selection variables in a managed `,_jsx(_components.code,{children:`env`}),` block, such as `,_jsx(_components.code,{children:`ANTHROPIC_MODEL`}),` and the `,_jsx(_components.code,{children:`ANTHROPIC_DEFAULT_*_MODEL`}),` family. A managed `,_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`availableModels`})}),` allowlist stays in force unless the host supplies its own.`]}),`\n`,_jsx(Heading,{level:`4`,id:`precedence-within-the-managed-tier`,children:`Precedence within the managed tier`}),`\n`,_jsxs(_components.p,{children:[`Apart from the cross-source keys listed after the ranking, Claude Code uses the first of these sources that delivers a non-empty configuration and ignores the rest rather than merging them. When that winning source is an MDM policy or managed settings file that configures a `,_jsx(_components.a,{href:`#compute-managed-settings-with-a-policy-helper`,children:_jsx(_components.code,{children:`policyHelper`})}),`, the helper’s output then replaces it; that section says how. Claude Code checks the sources in this order:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`Remote settings, delivered from claude.ai as `,_jsx(_components.a,{href:`/en/server-managed-settings`,children:`server-managed settings`}),` or by a `,_jsx(_components.a,{href:`/en/claude-apps-gateway`,children:`Claude apps gateway`})]}),`\n`,_jsx(_components.li,{children:`MDM or OS-level policies`}),`\n`,_jsxs(_components.li,{children:[`Managed settings files, `,_jsx(_components.code,{children:`managed-settings.d/*.json`}),` and `,_jsx(_components.code,{children:`managed-settings.json`}),` merged together`]}),`\n`,_jsx(_components.li,{children:`The HKCU registry, on Windows only`}),`\n`]}),`\n`,_jsx(_components.p,{children:`Claude Code honors a few keys from any admin-controlled managed source, not only the one it selected above. The user-writable HKCU registry source is excluded from these checks. These cross-source keys are:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`The sandbox lock keys `,_jsx(_components.code,{children:`sandbox.network.allowManagedDomainsOnly`}),` and `,_jsx(_components.code,{children:`sandbox.filesystem.allowManagedReadPathsOnly`}),`, with their associated allowlists`]}),`\n`,_jsx(_components.li,{children:_jsx(_components.code,{children:`allowAllClaudeAiMcps`})}),`\n`,_jsxs(_components.li,{children:[`The sandbox binary paths `,_jsx(_components.code,{children:`sandbox.bwrapPath`}),` and `,_jsx(_components.code,{children:`sandbox.socatPath`})]}),`\n`,_jsxs(_components.li,{children:[`The sandbox `,_jsx(_components.code,{children:`ripgrep`}),` binary, `,_jsx(_components.a,{href:`#sandbox-settings`,children:_jsx(_components.code,{children:`sandbox.ripgrep`})})]}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`/en/server-managed-settings`,children:_jsx(_components.code,{children:`forceRemoteSettingsRefresh`})})}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`env`}),`, which Claude Code merges per variable across the admin-controlled sources: each variable comes from the highest-priority source that defines it, so lower sources fill in variables the higher ones leave unset, or whose cached server value Claude Code is `,_jsx(_components.a,{href:`/en/server-managed-settings#fetch-and-caching-behavior`,children:`withholding pending server confirmation`}),`. The telemetry unit and credential-paired routing variables follow their own rules; see `,_jsx(_components.a,{href:`/en/server-managed-settings#per-key-exceptions-across-managed-sources`,children:`Per-key exceptions across managed sources`}),`. Requires Claude Code v2.1.223 or later. Before v2.1.223, Claude Code applied the selected source’s whole `,_jsx(_components.code,{children:`env`}),` block only`]}),`\n`]}),`\n`,_jsx(Heading,{level:`4`,id:`parent-settings-from-embedding-hosts`,children:`Parent settings from embedding hosts`}),`\n`,_jsxs(_components.p,{children:[`An embedding host such as Claude Desktop can supply policy through the SDK `,_jsx(_components.code,{children:`managedSettings`}),` option. By default, Claude Code ignores those parent settings whenever an admin-deployed managed source is present: server-managed settings, an MDM or OS-level policy, or a managed settings file. The user-writable HKCU registry source doesn’t count as admin-deployed.`]}),`\n`,_jsxs(_components.p,{children:[`To have Claude Code merge parent settings alongside an admin-deployed source, set `,_jsx(_components.a,{href:`#available-settings`,children:_jsx(_components.code,{children:`parentSettingsBehavior`})}),` to `,_jsx(_components.code,{children:`\"merge\"`}),` in the highest-priority managed source; Claude Code reads the key from that source only. It then passes the host’s values through a restrictive-only filter, with one gap to know about: unless you also set the `,_jsx(_components.code,{children:`allowManaged*Only`}),` locks, allow-direction settings from the host, such as permission allow rules and sandbox allowlists, still apply. See `,_jsx(_components.a,{href:`/en/claude-apps-gateway#restrict-parent-settings`,children:`Restrict parent settings`}),` for the locks. A `,_jsx(_components.a,{href:`#compute-managed-settings-with-a-policy-helper`,children:_jsx(_components.code,{children:`policyHelper`})}),` can turn parent merging off regardless of this key; that section says when.`]}),`\n`,_jsx(_components.p,{children:`Claude Code also applies these checks to specific parent-supplied values:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`When any admin-controlled managed source sets `,_jsx(_components.code,{children:`allowManagedPermissionRulesOnly`}),`, Claude Code drops `,_jsx(_components.a,{href:`/en/claude-apps-gateway#restrict-parent-settings`,children:`parent-supplied`}),` permission allow rules and `,_jsx(_components.code,{children:`additionalDirectories`}),` as it reads them, even when a higher-priority source leaves the key unset. The key’s effect on your own permission rules still comes from the highest-priority source only`]}),`\n`,_jsxs(_components.li,{children:[`A `,_jsx(_components.code,{children:`forceLoginOrgUUID`}),` or `,_jsx(_components.code,{children:`allowedMcpServers`}),` value in the highest-priority admin source blocks a parent-supplied one, and Claude Code enforces the admin value. A value in a non-selected admin source neither applies nor blocks the parent’s. Before v2.1.223, a value in any admin source blocked the parent’s`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`verify-active-settings`,children:`Verify active settings`}),`\n`,_jsxs(_components.p,{children:[`Run `,_jsx(_components.code,{children:`/status`}),` inside Claude Code to see which settings sources are active. Inside the menu, the `,_jsx(_components.strong,{children:`Status`}),` tab includes a `,_jsx(_components.code,{children:`Setting sources`}),` line that lists each layer Claude Code loaded for the current session, such as `,_jsx(_components.code,{children:`User settings`}),` or `,_jsx(_components.code,{children:`Project local settings`}),`. When `,_jsx(_components.a,{href:`/en/admin-setup#decide-how-settings-reach-devices`,children:`managed settings`}),` are in effect, the entry shows the delivery channel in parentheses, for example `,_jsx(_components.code,{children:`Enterprise managed settings (remote)`}),`, `,_jsx(_components.code,{children:`(plist)`}),`, `,_jsx(_components.code,{children:`(HKLM)`}),`, `,_jsx(_components.code,{children:`(HKCU)`}),`, or `,_jsx(_components.code,{children:`(file)`}),`. The `,_jsx(_components.code,{children:`remote`}),` channel covers both claude.ai server-managed settings and `,_jsx(_components.a,{href:`/en/claude-apps-gateway`,children:`Claude apps gateway`}),`-delivered policies. A layer appears in the list only when that source is loaded with at least one key, so an empty list means no settings sources were found.`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`Setting sources`}),` line confirms which sources are being read. It does not show which layer supplied each individual key. The `,_jsx(_components.strong,{children:`Config`}),` tab in the same dialog is an editor for a fixed set of toggles such as theme and verbose output, not a view of your `,_jsx(_components.code,{children:`settings.json`}),` contents.`]}),`\n`,_jsxs(_components.p,{children:[`If a user, project, or local settings file contains errors, such as invalid JSON or a value that fails validation, an interactive session shows a `,_jsx(_components.strong,{children:`Settings Error`}),` dialog at startup. The dialog lets you fix the file with Claude’s help, exit, or continue without the broken settings.`]}),`\n`,_jsxs(_components.p,{children:[`After you continue, `,_jsx(_components.code,{children:`/status`}),` lists the affected files. Run `,_jsx(_components.code,{children:`claude doctor`}),` to see the details for each error.`]}),`\n`,_jsxs(_components.p,{children:[`Managed settings entries that fail validation follow the more tolerant flow described in `,_jsx(_components.a,{href:`#invalid-entries-in-managed-settings`,children:`Invalid entries in managed settings`}),`: the file isn’t rejected as a whole, and the remaining valid policies stay enforced.`]}),`\n`,_jsx(Heading,{level:`3`,id:`key-points-about-the-configuration-system`,children:`Key points about the configuration system`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`Memory files (`,_jsx(_components.code,{children:`CLAUDE.md`}),`)`]}),`: Contain instructions and context that Claude loads at startup`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Settings files (JSON)`}),`: Configure permissions, environment variables, and tool behavior`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Skills`}),`: Custom prompts that can be invoked with `,_jsx(_components.code,{children:`/skill-name`}),` or loaded by Claude automatically`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`MCP servers`}),`: Extend Claude Code with additional tools and integrations`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Precedence`}),`: Higher-level configurations (Managed) override lower-level ones (User/Project)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Inheritance`}),`: Settings merge across scopes; scalar values from higher-priority scopes override and arrays concatenate, each with the exceptions described under `,_jsx(_components.a,{href:`#settings-precedence`,children:`Settings precedence`})]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`system-prompt`,children:`System prompt`}),`\n`,_jsxs(_components.p,{children:[`Claude Code’s internal system prompt is not published. To add custom instructions, use `,_jsx(_components.code,{children:`CLAUDE.md`}),` files or the `,_jsx(_components.code,{children:`--append-system-prompt`}),` flag.`]}),`\n`,_jsx(Heading,{level:`3`,id:`exclude-sensitive-files`,children:`Exclude sensitive files`}),`\n`,_jsxs(_components.p,{children:[`To prevent Claude Code from accessing files containing sensitive information like API keys, secrets, and environment files, use the `,_jsx(_components.code,{children:`permissions.deny`}),` setting in your `,_jsx(_components.code,{children:`.claude/settings.json`}),` file:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`11`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`11`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D