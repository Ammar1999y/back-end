,{children:`~/`})}),_jsx(_components.td,{style:{textAlign:`left`},children:`Relative to home directory`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`~/.kube`}),` becomes `,_jsx(_components.code,{children:`$HOME/.kube`})]})]}),_jsxs(_components.tr,{children:[_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`./`}),` or no prefix`]}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Relative to the project root for project settings, or to `,_jsx(_components.code,{children:`~/.claude`}),` for user settings`]}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`./output`}),` in `,_jsx(_components.code,{children:`.claude/settings.json`}),` resolves to `,_jsx(_components.code,{children:`\u003cproject-root\u003e/output`})]})]})]})]}),`\n`,_jsxs(_components.p,{children:[`The older `,_jsx(_components.code,{children:`//path`}),` prefix for absolute paths still works. If you previously used single-slash `,_jsx(_components.code,{children:`/path`}),` expecting project-relative resolution, switch to `,_jsx(_components.code,{children:`./path`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code strips a trailing slash from a directory path, so `,_jsx(_components.code,{children:`~/.aws`}),` and `,_jsx(_components.code,{children:`~/.aws/`}),` match the same directory. Before v2.1.224, Claude Code passed the trailing slash through to the sandbox, and Claude could still read or write paths under a `,_jsx(_components.code,{children:`denyRead`}),` or `,_jsx(_components.code,{children:`denyWrite`}),` entry written with one.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code also removes a trailing `,_jsx(_components.code,{children:`/**`}),`, so `,_jsx(_components.code,{children:`~/build/**`}),` and `,_jsx(_components.code,{children:`~/build`}),` cover the same directory. For the four `,_jsx(_components.code,{children:`filesystem`}),` lists, whether a