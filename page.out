ions`}),`, which writes this key to user settings. The row requires Claude Code v2.1.232 or later, and Claude Code hides it while the `,_jsx(_components.code,{children:`--settings`}),` flag or managed settings set the key`]}),_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`\"hold\"`})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`defaultShell`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`\"bash\"`}),`, or `,_jsx(_components.code,{children:`\"powershell\"`}),` on Windows when Bash isn’t available. Default shell for input-box `,_jsx(_components.code,{children:`!`}),` commands. Accepts `,_jsx(_components.code,{children:`\"bash\"`}),` or `,_jsx(_components.code,{children:`\"powershell\"`}),`. Setting `,_jsx(_components.code,{children:`\"powershell\"`}),` routes interactive `,_jsx(_components.code,{children:`!`}),` commands through PowerShell when the `,_jsx(_components.a,{href:`/en/tools-reference#powershell-tool`,children:`PowerShell tool`}),` is enabled: it’s on by default on Windows without Git Bash, and `,_jsx(_components.code,{children:`CLAUDE_CODE_USE_POWERSHELL_TOOL=1`}),` enables it elsewhere`]}),_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`\"powershell\"`})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`deniedMcpServers`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`When set in managed-settings.json, denylist of MCP servers that are explicitly blocked. Applies to all scopes including managed servers. Denylist takes precedence over allowlist. See `,_jsx(_components.a,{href:`/en/managed-mcp`,children:`Managed MCP configuration`})]}),_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{chil