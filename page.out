sx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`      }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`4`,id:`enabledplugins`,children:_jsx(_components.code,{children:`enabledPlugins`})}),`\n`,_jsxs(_components.p,{children:[`Controls which plugins are enabled. Format: `,_jsx(_components.code,{children:`\"plugin-name@marketplace-name\": true/false`}),`. A plugin with no entry at any scope falls back to its `,_jsx(_components.a,{href:`/en/plugins-reference#default-enablement`,children:_jsx(_components.code,{children:`defaultEnabled`})}),` value.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Scopes`}),`:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`User settings`}),` (`,_jsx(_components.code,{children:`~/.claude/settings.json`}),`): Personal plugin preferences`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Project settings`}),` (`,_jsx(_components.code,{children:`.claude/settings.json`}),`): Project-specific plugins shared with team`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Local settings`}),` (`,_jsx(_components.code,{children:`.claude/settings.local.json`}),`): Per-machine overrides, gitignored when Claude Code saves a setting to it`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Managed settings`}),` (`,_jsx(_components.code,{children:`managed-settings.json`}),`): Organization-wide policy overrides that block installation at all scopes and hide the plugin from the marketplace`]}),`\n`]}),`\n`,_jsxs(Note,{children:[_jsxs(_components.p,{children:[`Project settings take precedence over user settings, so setting a plugin to `,_jsx(_components.code,{children:`false`}),` in `,_jsx(_components.code,{children:`~/.claude/settings.json`}),` does not disable a plugin that the project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` enables. To opt out of a project-enabled plugin on your machine, set it to `,_jsx(_components.code,{children:`false`}),` in `,_jsx(_components.code,{children:`.claude/settings.local.json`}),` instead.`]}),_jsx(_components.p,{children:`Plugins force-enabled by managed settings cannot be disabled this way, since managed settings override local settings.`}),_jsxs(_components.p,{children:[`Enabling a plugin from an external source such as a GitHub repository or npm package in a project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` doesn’t install it for other people. On every path that loads plugins, Claude Code reports the plugin as not installed until each user `,_jsx(_components.a,{href:`/en/discover-plugins#configure-team-marketplaces`,children:`installs it themselves`}),`.`]})]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Example`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`7`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`7`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"enabledPlugins\"`}),_jsx(_compon