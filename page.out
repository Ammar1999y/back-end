e:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"https://git.example.com/security/plugins.git\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`      }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Marketplace source types`}),`:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`github`}),`: GitHub repository (uses `,_jsx(_components.code,{children:`repo`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`git`}),`: Any git URL (uses `,_jsx(_components.code,{children:`url`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`url`}),`: Direct URL to a `,_jsx(_components.code,{children:`marketplace.json`}),` file (uses `,_jsx(_components.code,{children:`url`}),`, plus optional `,_jsx(_components.code,{children:`headers`}),` for authenticated access)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`file`}),`: Local path to a `,_jsx(_components.code,{children:`marketplace.json`}),` file (uses `,_jsx(_components.code,{children:`path`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`directory`}),`: Local filesystem path (uses `,_jsx(_components.code,{children:`path`}),`, for development only)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`hostPattern`}),`: regex pattern to match marketplace hosts (uses `,_jsx(_components.code,{children:`hostPattern`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`settings`}),`: inline marketplace declared directly in settings.json without a separate hosted repository (uses `,_jsx(_components.code,{children:`name`}),` and `,_jsx(_components.code,{children:`plugins`}),`)`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`git`}),` source type works with any git hosting service, including self-hosted GitLab and Bitbucket. Claude Code clones the repository with the same authentication that `,_jsx(_components.code,{children:`git clone`}),` would use on that machine: configured credential helpers or SSH keys. A provider token such as `,_jsx(_components.code,{children:`GITHUB_TOKEN`}),` takes effect only through a credential helper that reads it. See `,_jsx(_components.a,{href:`/en/plugin-marketplaces#private-repositories`,children:`Private repositories`}),` for setup details.`]}),`\n`,_jsxs(_components.p,{children:[`For `,_jsx(_components.code,{children:`github`}),` and `,_jsx(_components.code,{children:`git`}),` sources, set `,_jsx(_components.code,{children:`\"skipLfs\": true`}),` inside the `,_jsx(_components.code,{children:`source`}),` object (alongside `,_jsx(_components.code,{children:`repo`}),` or `,_jsx(_components.code,{children:`url`}),`) to skip Git LFS downloads when Claude Code clones or updates the marketplace repository. LFS pointer files remain as pointers instead of downloading their content. Use this when the repository contains large LFS objects unrelated to plugin content. Requires Claude Code v2.1.153 or later.`]}),`\n`,_jsxs(_components.p,{children:[`Each marketplace entry also accepts an optional `,_jsx(_components.code,{children:`autoUpdate`}),` Boolean. Set `,_jsx(_components.code,{children:`\"autoUpdate\": true`}),` alongside `,_jsx(_components.code,{children:`source`}),` to make Claude Code refresh that marketplace and update its installed plugins in the background after startup. When omitted, official Anthropic marketplaces default to `,_jsx(_components.code,{children:`true`}),` and all other marketplaces default to `,_jsx(_components.code,{children:`false`}),`. See `,_jsx(_components.a,{href:`/en/discover-plugins#configure-auto-updates`,children:`Configure auto-updates`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`When more than one settings file defines a marketplace entry under the same name, Claude Code uses the entry from the `,_jsx(_components.a,{href:`#settings-precedence`,children:`highest-precedence file`}),` whole. That entry replaces the lower-precedence entry and inherits none of its fields, so a redefinition can’t combine one file’s `,_jsx(_components.code,{children:`source.headers`}),` credential with a URL another file controls. Before v2.1.228, Claude Code merged same-name entries field by field, so an entry in a higher-precedence file could inherit fields it didn’t set, including another file’s `,_jsx(_components.code,{children:`headers`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Use `,_jsx(_components.code,{children:`source: 'settings'`}),` to declare a small set of plugins inline without setting up a hosted marketplace repository. Plugins listed here must reference external sources such as GitHub or npm. You still need to enable each plugin separately in `,_jsx(_components.code,{children:`enabledPlugins`}),`.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`19`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`19`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},chil