onents.li,{children:`Restrictions are checked before any network requests or filesystem operations`}),`\n`,_jsx(_components.li,{children:`When blocked, users see clear error messages indicating the source is blocked by managed policy`}),`\n`,_jsx(_components.li,{children:`The restriction is enforced on marketplace add and on plugin install, update, refresh, and auto-update. A marketplace added before the policy was set cannot be used to install or update plugins once its source no longer matches the allowlist`}),`\n`,_jsx(_components.li,{children:`Managed settings have the highest precedence and cannot be overridden`}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`See `,_jsx(_components.a,{href:`/en/plugin-marketplaces#managed-marketplace-restrictions`,children:`Managed marketplace restrictions`}),` for user-facing documentation.`]}),`\n`,_jsx(Heading,{level:`4`,id:`strictpluginonlycustomization`,children:_jsx(_components.code,{children:`strictPluginOnlyCustomization`})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Managed settings only`}),`: blocks skills, agents, hooks, and MCP servers from user and project sources, so they can only come from plugins or managed settings. Combine it with `,_jsx(_components.code,{children:`strictKnownMarketplaces`}),` to control the full customization supply chain: the marketplace allowlist controls which plugins users can install, and this setting blocks everything that doesn’t come from a plugin or from managed settings.`]}),`\n`,_jsxs(_components.p,{children:[`The value is either `,_jsx(_components.code,{children:`true`}),` to lock all four surfaces, or an array naming the surfaces to lock:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,