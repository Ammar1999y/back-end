{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "security:openssf-scorecard",
    "security:minimumReleaseAgeNpm",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Riyadh",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "urgent"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false
  },
  "packageRules": [
    {
      "description": "Require manual approval for TypeScript toolchain majors.",
      "matchPackageNames": ["typescript", "@types/node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "typescript toolchain (major)",
      "labels": ["dependencies", "needs-migration"]
    },
    {
      "description": "Upgrade Bun types with the pinned Bun runtime.",
      "matchPackageNames": ["@types/bun", "bun-types"],
      "dependencyDashboardApproval": true,
      "groupName": "bun types"
    },
    {
      "description": "Group all non-major dev tooling into a single PR instead of flooding.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dev tooling (non-major)"
    },
    {
      "description": "Group non-major runtime deps; majors stay separate for review.",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "runtime dependencies (non-major)"
    },
    {
      "description": "Better Auth core and plugins must move together.",
      "matchPackageNames": ["better-auth", "@better-auth/**"],
      "groupName": "better-auth"
    },
    {
      "description": "Drizzle ORM and its kit must move together.",
      "matchPackageNames": [
        "drizzle-orm",
        "drizzle-kit",
        "eslint-plugin-drizzle"
      ],
      "groupName": "drizzle"
    },
    {
      "description": "GitHub Actions pinned by major only.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Scanner binaries move together and are never grouped with app deps.",
      "matchManagers": ["mise"],
      "groupName": "scanner toolchain"
    }
  ]
}
