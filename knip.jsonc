{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "tags": ["-knipignore"],
  // Entries used to be inferred by knip's Next.js plugin, which treated every
  // `app/**/route.ts` as a root. Next is gone, and so are those files, so the
  // real runtime graph now has exactly one root: `server.ts`. It validates the
  // runtime and then dynamically imports `app.ts`, which imports `routes.ts`,
  // which imports every handler — knip follows dynamic imports, so the chain
  // needs no extra entry.
  //
  // Declaring `entry` at all REPLACES knip's defaults, which is why the test
  // patterns below have to be spelled out: without them knip's built-in
  // `**/*.test.ts` root disappears and every file under `tests/` reports as
  // unused. That is exactly what happened when `scripts/probe/local` moved to
  // `tests/` — the old `scripts/**/*.ts` entry had been covering it by accident.
  "entry": [
    "server.ts",
    "scripts/**/*.ts",
    // `.mjs` as well as `.ts`: `scripts/require-bun.mjs` is the `preinstall`
    // hook, run by `node` from a package.json script string, so no import edge
    // reaches it. It is plain `.mjs` because npm must be able to execute it
    // before `node_modules` exists.
    "scripts/**/*.mjs",
    // The benchmark harness is tracked but standalone — run by hand, never
    // imported by the application. Declared the same way in
    // scripts/find-unused-files.ts. Extension-agnostic on purpose: `bench/s3` is
    // TypeScript and a `bun test` suite, the rest is `.mjs`.
    "bench/**",

    // ---- the test suite -----------------------------------------------------
    // One pattern per tier rather than `tests/**`, so a file that lands outside
    // a tier is still reported. `tests/unit/harness-layout.test.ts` asserts the
    // same partition from the other side.
    "tests/unit/**/*.test.ts",
    "tests/integration/**/*.test.ts",
    "tests/process/**/*.test.ts",
    // Spawned as programs by path string from a sibling test, so no import edge
    // exists for knip to follow. They are entry points, not ignored files —
    // declaring them here keeps THEIR imports checked, which `ignore` would not.
    "tests/fixtures/_*.ts",
    "tests/fixtures/_*.cjs",
    // Loaded by `--preload`, which `tests/helpers/run.ts` passes as a string on
    // the `bun test` command line. Same situation: a real root with no import
    // edge. `preload-base.ts` needs no entry of its own — knip resolves it from
    // `bunfig.toml`'s `[test] preload`.
    "tests/helpers/preload-database.ts",
  ],
  // `drizzle.config.ts`, `eslint.config.mjs` and `prettier.config.js` used to be
  // listed here and are not any more: knip recognises all three as tool configs
  // on its own and reported each as a redundant entry pattern.
  //
  // Nothing is ignored. The previous entry — `scripts/probe/local/_*-child.cjs`
  // — pointed at a directory that no longer exists, and knip flagged it as a
  // stale config hint; the children it covered are now declared as entries above.
  //
  // Both of these are loaded by name through `FlatCompat.extends()` in
  // eslint.config.mjs. Knip resolves imports statically, so it cannot see
  // string-addressed plugins. Verified active with `eslint --print-config`.
  "ignoreDependencies": [
    "eslint-plugin-no-unsanitized",
    "eslint-plugin-security",
  ],
  // `mise` is invoked by the `scan:*` scripts and installed by `mise.toml`
  // rather than by `bun install`, so it is deliberately not a dependency.
  "ignoreBinaries": ["mise"],
}
